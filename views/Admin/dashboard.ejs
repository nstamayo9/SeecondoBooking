                                                        <input type="text" name="newTotalPrice" id="totalPrice-<%= booking._id %>" class="form-control fw-bold text-primary text-end px-1" value="<%= booking.totalPrice.toLocaleString() %>" onfocus="removeCommas(this)" onblur="formatCurrency(this); calculateBalance('<%= booking._id %>')" oninput="calculateBalance('<%= booking._id %>')">
                                                    </div>
                                                </div>

                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="xs-label text-success fw-bold">Paid:</span>
                                                    <div class="d-flex align-items-center justify-content-end w-50">
                                                        <div class="input-group input-group-sm">
                                                            <span class="input-group-text px-1 bg-success text-white">₱</span>
                                                            <input type="text" name="amountPaid" id="amountPaid-<%= booking._id %>" class="form-control fw-bold text-success text-end px-1" value="<%= (booking.amountPaid || 0).toLocaleString() %>" onfocus="removeCommas(this)" onblur="formatCurrency(this); calculateBalance('<%= booking._id %>')" oninput="calculateBalance('<%= booking._id %>')">
                                                        </div>
                                                        <div id="paidIcon-<%= booking._id %>" class="ms-2" style="width: 20px;"></div>
                                                    </div>
                                                </div>

                                                <div class="d-flex justify-content-between align-items-center bg-light p-1 rounded">
                                                    <span class="xs-label text-danger fw-bold">BALANCE:</span>
                                                    <span class="fw-bold text-danger fs-6">₱<span id="balanceDisplay-<%= booking._id %>">0</span></span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="mb-0"><label class="xs-label">Admin Notes</label><textarea name="adminNotes" class="form-control form-control-sm" rows="2"><%= booking.adminNotes %></textarea></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="modal-footer bg-white">
                        <button type="button" class="btn btn-light text-muted fw-bold" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-primary fw-bold px-4 shadow-sm"><i class="fas fa-save me-2"></i> Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
<% }) %>

