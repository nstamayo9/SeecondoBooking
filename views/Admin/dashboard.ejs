    </div>
</div>
<!-- SCRIPTS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        // State management for each booking modal
        const bookingState = {};

        // --- FORMATTING HELPERS ---
        function formatCurrency(input) {
            let val = input.value.replace(/,/g, '');
            if (!val) return;
            input.value = parseFloat(val).toLocaleString();
        }

        function removeCommas(input) {
            input.value = input.value.replace(/,/g, '');
        }

document.addEventListener('DOMContentLoaded', function() {
    // ============================================================
    // 1. INITIALIZE GLOBAL STATE
    // ============================================================
    if (typeof bookingState === 'undefined') var bookingState = {};

// ============================================================
    // 2. INITIALIZE MANUAL BOOKING PICKERS (FOR /staff/book)
    // ============================================================
    let mainFpIn = null;
    let mainFpOut = null;

    const checkInInput = document.getElementById('checkIn');
    const checkOutInput = document.getElementById('checkOut');
    const roomSelect = document.getElementById('roomId') || document.getElementById('roomSelect');
    const amountPaidInput = document.getElementById('amountPaid');

    if (checkInInput && checkOutInput) {
        const fpConfig = {
            enableTime: true,
            dateFormat: "Y-m-d H:i",
        };

        // Initialize Check-Out
        mainFpOut = flatpickr(checkOutInput, {
            ...fpConfig,
            onChange: function() {
                // Trigger calculation if a room is already selected
                if (typeof runFullManualCalculation === 'function') runFullManualCalculation();
            }
        });

        // Initialize Check-In
        mainFpIn = flatpickr(checkInInput, {
            ...fpConfig,
            onChange: function(selectedDates) {
                if (selectedDates.length > 0) {
                    const nextDay = new Date(selectedDates[0]);
                    nextDay.setDate(nextDay.getDate() + 1);
                    nextDay.setHours(11, 0, 0, 0);
                    mainFpOut.setDate(nextDay);
                    
                    // Trigger calculation
                    if (typeof runFullManualCalculation === 'function') runFullManualCalculation();
                }
            }
        });
    }

    // Add listeners for Manual Booking Amount & Room Selection
    if (roomSelect) {
        roomSelect.addEventListener('change', () => {
            if (typeof runFullManualCalculation === 'function') runFullManualCalculation();
        });
    }

    if (amountPaidInput) {
        amountPaidInput.addEventListener('input', () => {
            if (typeof calculateManualBalance === 'function') calculateManualBalance();
        });
    }

    // ============================================================
    // 3. HANDLE URL PARAMS (FROM CALENDAR CLICK)
    // ============================================================
    const params = new URLSearchParams(window.location.search);
    const checkInParam = params.get('checkIn'); // Expected: YYYY-MM-DD
    const roomIdParam = params.get('roomId');

    // Pre-fill Room Select
    if (roomIdParam && roomSelect) {
        roomSelect.value = roomIdParam;
        // Trigger 'change' so any price/capacity logic in your controller/UI fires
        roomSelect.dispatchEvent(new Event('change'));
    }

    // Pre-fill Check-In Date
    if (checkInParam && mainFpIn) {
        // We add "14:00" to provide a default check-in time
        mainFpIn.setDate(`${checkInParam} 14:00`, true); 
    }
    
    
    const allModals = document.querySelectorAll('.modal');
    allModals.forEach(modal => {
        modal.addEventListener('shown.bs.modal', function () {
            // Get the ID (e.g., from "modal-65a..." to "65a...")
            const bookingId = this.id.split('-')[1];
            
            if (bookingId) {
                console.log("Recalculating fees for modal:", bookingId);
                // 1. Calculate Base Price & Extra Fees (Early In/Late Out)
                runFullCalculation(bookingId);
                
                // 2. Calculate the Balance based on the Total and Paid
                calculateBalance(bookingId);
            }
        });
    });
    
    // ============================================================
    // 4. INITIALIZE FINANCIAL REPORT RANGE PICKER
    // ============================================================
    const reportRangeInput = document.getElementById('reportDateRange');
    if (reportRangeInput) {
        flatpickr(reportRangeInput, {
            mode: "range",        // Enables Start and End date selection
            dateFormat: "Y-m-d",  // Format sent to your server
            altInput: true,       // Shows a prettier format to the user
            altFormat: "F j, Y",  // e.g., March 13, 2026
            allowInput: true,
            // Optional: Default to the current month
            defaultDate: [
                new Date(new Date().getFullYear(), new Date().getMonth(), 1), 
                new Date()
            ]
        });
    }

// ============================================================
// 4. INITIALIZE EXISTING BOOKING MODALS (WITH AUTO-CALC)
// ============================================================
document.querySelectorAll('[id^="modal-"]').forEach(modal => {
    const bookingId = modal.id.split('-')[1];
    bookingState[bookingId] = { isB1T1Applied: false, fpOut: null, fpIn: null };

    const inEl = document.getElementById(`checkIn-${bookingId}`);
    const outEl = document.getElementById(`checkOut-${bookingId}`);

    if (inEl && outEl) {
        // Initialize Check-Out Picker
        bookingState[bookingId].fpOut = flatpickr(outEl, { 
            enableTime: true, 
            dateFormat: "Y-m-d H:i",
            onChange: function() {
                // Trigger calculation immediately when time changes
                runFullCalculation(bookingId);
            }
        });

        // Initialize Check-In Picker
        bookingState[bookingId].fpIn = flatpickr(inEl, {
            enableTime: true,
            dateFormat: "Y-m-d H:i",
            onChange: function(selectedDates) {
                if (selectedDates.length > 0) {
                    // Logic to ensure Check-out isn't before Check-in
                    const nextDay = new Date(selectedDates[0]);
                    nextDay.setDate(nextDay.getDate() + 1);
                    bookingState[bookingId].fpOut.set('minDate', selectedDates[0]);
                    
                    // Trigger calculation immediately
                    runFullCalculation(bookingId);
                }
            }
        });
    }
});
    
    // ============================================================
    // 4b. AUTO-CALCULATE BALANCE WHEN MODAL OPENS
    // ============================================================
    document.querySelectorAll('.modal').forEach(modal => {
        modal.addEventListener('shown.bs.modal', function () {
            // Extract the booking ID from the modal's ID (e.g., "modal-65a..." -> "65a...")
            const bookingId = this.id.split('-')[1];
            
            if (bookingId) {
                console.log("Modal opened, calculating balance for:", bookingId);
                // This ensures the balance display is correct the moment you see it
                calculateBalance(bookingId); 
                
                // Optional: Also run fee calculation to ensure nightly rates are displayed
                if (typeof runFullCalculation === 'function') {
                    runFullCalculation(bookingId);
                }
            }
        });
    });

    // ============================================================
    // 5. FULLCALENDAR LOGIC
    // ============================================================
    const calendarEl = document.getElementById('adminCalendar');
    if (calendarEl) {
        const calendarModal = document.getElementById('calendarModal');
        let calendarInstance = null;

        calendarModal.addEventListener('shown.bs.modal', function() {
            if (!calendarInstance) {
                calendarInstance = new FullCalendar.Calendar(calendarEl, {
                    schedulerLicenseKey: 'CC-Attribution-NonCommercial-NoDerivatives',
                    initialView: 'resourceTimelineMonth',
                    height: '100%',
                    slotLabelFormat: [
                            { weekday: 'short'},
                            {day: 'numeric' }
                            ],
                            
                    buttonText: {
                                today: 'Today'
                            },
                    selectable: true,
                    resourceAreaWidth: '15%',
                    resourceAreaHeaderContent: 'Rooms',
                    resources: { url: '/admin/calendar-resources' },
                    events: '/admin/calendar-events',
                    
                    
                    eventClassNames: function(arg) {
                            const status = (arg.event.extendedProps.status || '').toLowerCase();
                            const classes = { 'pending': 'event-pending', 'confirmed': 'event-confirmed', 'completed': 'event-completed', 'cancelled': 'event-cancelled' };
                            return [classes[status] || 'bg-info'];
                        },

                        datesSet: function(info) {
                            const date = info.view.currentStart;
                            document.getElementById('currentYearDisplay').innerText = date.getFullYear();
                            document.querySelectorAll('#customMonthList button').forEach(btn => {
                                btn.classList.toggle('active', parseInt(btn.dataset.month) === date.getMonth());
                            });
                        },
                        
                        
                    // The "Select" action triggers the redirect
                    select: function(info) {
                        const rId = info.resource ? info.resource.id : '';
                        // Redirecting to the manual booking route
                        window.location.href = `/staff/book?checkIn=${info.startStr}&roomId=${rId}`;
                    },
                    
                    eventContent: function(arg) {

                        if (arg.event.display === 'background') {
                            return { html: `<div class="fc-event-title">${arg.event.title}</div>` };
                        }

                        const shortId = arg.event.extendedProps.shortId || '';
                        const guestName = arg.event.extendedProps.guestName || 'Guest';

                        return { 
                            html: `
                                <div style="line-height:1.2; padding:2px;">
                                    <div class="event-shortid">#${shortId}</div>
                                    <div class="fc-event-title">${guestName}</div>
                                </div>
                            ` 
                        };
                    },
                    
                  displayEventTime: false,
                  eventTimeFormat: { hour: '2-digit', minute: '2-digit', meridiem: false },
                  
                                              // --- INTERACTIVITY: CLICK EVENT TO OPEN DETAILS MODAL ---
                            eventClick: function(info) {
                                info.jsEvent.preventDefault();
                                
                                if (eventModal) {
                                    // Populate Modal Data
                                    const props = info.event.extendedProps;
                                    
                                    // Safe check for elements before setting text
                                    if(document.getElementById('modalTitle')) document.getElementById('modalTitle').innerText = info.event.title;
                                    if(document.getElementById('modalGuest')) document.getElementById('modalGuest').innerText = props.guestName || 'N/A';
                                    if(document.getElementById('modalRoom')) document.getElementById('modalRoom').innerText = props.roomName || 'N/A';
                                    
                                    // Badge Logic
                                    const statusSpan = document.getElementById('modalStatus');
                                    if(statusSpan) {
                                        statusSpan.innerText = (props.status || '').toUpperCase();
                                        statusSpan.className = 'badge'; // reset
                                        if(props.status === 'confirmed') statusSpan.classList.add('bg-success');
                                        else if(props.status === 'pending') statusSpan.classList.add('bg-warning');
                                        else statusSpan.classList.add('bg-secondary');
                                    }

                                    if(document.getElementById('modalPayment')) document.getElementById('modalPayment').innerText = (props.paymentStatus || '').toUpperCase();
                                    if(document.getElementById('modalBalance')) document.getElementById('modalBalance').innerText = (props.balance || 0).toLocaleString();

                                    // Update Buttons
                                    const btnEdit = document.getElementById('btnEdit');
                                    if(btnEdit) btnEdit.href = `/booking/edit/${info.event.id}`;
                                    
                                    eventModal.show();
                                } else if (info.event.url) {
                                    // Fallback if modal doesn't exist
                                    window.location.href = info.event.url; 
                                }
                            },
                  

                });
                calendarInstance.render();

                     // Month Buttons
                        document.querySelectorAll('#customMonthList button').forEach(btn => {
                            btn.addEventListener('click', function() {
                                const selectedMonth = parseInt(this.dataset.month);
                                const currentYear = calendarInstance.getDate().getFullYear();
                                calendarInstance.gotoDate(new Date(currentYear, selectedMonth, 1));
                            });
                        });

                        // Year Buttons
                        document.getElementById('prevYearBtn').addEventListener('click', () => calendarInstance.prevYear());
                        document.getElementById('nextYearBtn').addEventListener('click', () => calendarInstance.nextYear());   
                    } else { 
                        calendarInstance.updateSize(); 
                        calendarInstance.refetchEvents(); 
                        // Also refetch resources in case a room was added/removed
                        calendarInstance.refetchResources();
                    }
                });
    }

    // ============================================================
    // 6. GLOBAL HELPERS (Reports & Promotions)
    // ============================================================
    if (document.querySelector("#eligibleDatesInput")) {
        flatpickr("#eligibleDatesInput", { mode: "multiple", dateFormat: "Y-m-d", minDate: "today" });
    }

    <% if (typeof promotions !== 'undefined') { %>
        <% promotions.forEach(p => { %>
            flatpickr("#editDates-<%= p._id %>", { 
                mode: "multiple", 
                dateFormat: "Y-m-d", 
                defaultDate: <%- JSON.stringify(p.eligibleDates) %> 
            });
        <% }) %>
    <% } %>
});
        // --- CORE CALCULATION FUNCTIONS ---

function runFullCalculation(id) {
    const financials = calculateAdminFees(id); 
    
    const discountDisplay = document.getElementById(`discountDisplay-${id}`);
    let currentDiscount = 0;
    if(discountDisplay) {
        currentDiscount = parseFloat(discountDisplay.innerText.replace(/,/g, '')) || 0;
    }
    
    const newTotal = (financials.basePrice + financials.extraFee) - currentDiscount;
    const totalInput = document.getElementById(`totalPrice-${id}`);
    
    if(totalInput) {
        // Keep it as a formatted string for the UI
        totalInput.value = newTotal.toLocaleString(); 
    }

    // ALWAYS recalculate balance after total changes
    calculateBalance(id);
}

function calculateAdminFees(id) {
    const checkInEl = document.getElementById(`checkIn-${id}`);
    const checkOutEl = document.getElementById(`checkOut-${id}`);
    const basePriceDisplay = document.getElementById(`basePriceDisplay-${id}`);
    const feeDisplay = document.getElementById(`feeDisplay-${id}`);
    const feeTextEl = document.getElementById(`feeText-${id}`);
    const feeInput = document.getElementById(`extraFeeInput-${id}`);
    const roomSelect = document.getElementById(`roomSelect-${id}`);
    
    if(!roomSelect) return { basePrice: 0, extraFee: 0 };

    const selectedOption = roomSelect.options[roomSelect.selectedIndex];
    const pricePerNight = parseFloat(selectedOption.getAttribute('data-price')) || 0; 
    const category = selectedOption.getAttribute('data-category');
    
// 1. Determine Dates (Priority: Flatpickr -> Input Value -> Current Date)
    let inDate, outDate;

    // Helper to safely parse dates
    const parseDate = (val) => {
        const d = new Date(val);
        return isNaN(d.getTime()) ? null : d;
    };

    // Process Check-In
    const state = bookingState[id] || {};
    if (state.fpIn && state.fpIn.selectedDates.length > 0) {
        inDate = state.fpIn.selectedDates[0];
    } else {
        inDate = parseDate(checkInEl.value);
    }

    // Process Check-Out
    if (state.fpOut && state.fpOut.selectedDates.length > 0) {
        outDate = state.fpOut.selectedDates[0];
    } else {
        outDate = parseDate(checkOutEl.value);
    }

    // 2. STOP if we don't have valid dates to prevent "NaN" fees
    if (!inDate || !outDate) {
        console.warn(`Invalid dates for booking ${id}: In=${inDate}, Out=${outDate}`);
        return { basePrice: 0, extraFee: 0 };
    }
    
    // 1. Calculate Nights & Base Price
    const diffTime = outDate - inDate; 
    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)); 
    const basePrice = Math.max(0, diffDays * pricePerNight);
    
    // 2. Define Hourly Rates (Fallback to 500/1000 if config fails)
    const rateSmall = Number("<%= config.feeSmallRoom %>") || 500; 
    const rateLarge = Number("<%= config.feeLargeRoom %>") || 1000;
    let hourlyRate = (['Studio', '1BR'].includes(category)) ? rateSmall : rateLarge;
    
    let extraFee = 0; 
    let reasons = [];
    
    // 3. Early Check-In Logic (Before 2:00 PM / 14:00)
    if (inDate.getHours() < 14) { 
        const hrs = 14 - inDate.getHours(); 
        extraFee += hrs * hourlyRate; 
        reasons.push(`Early In (${hrs}h)`); 
    }
    
    // 4. Late Check-Out Logic (After 11:00 AM)
    let lateHrs = 0; 
    if (outDate.getHours() > 11) { 
        lateHrs = outDate.getHours() - 11; 
    } else if (outDate.getHours() === 11 && outDate.getMinutes() > 0) { 
        lateHrs = 1; 
    }
    
    if (lateHrs > 0) { 
        extraFee += lateHrs * hourlyRate; 
        reasons.push(`Late Out (${lateHrs}h)`); 
    }
    
    // 5. Update UI Elements
    if(basePriceDisplay) basePriceDisplay.innerText = basePrice.toLocaleString();
    if(feeDisplay) feeDisplay.innerText = extraFee.toLocaleString();
    if(feeInput) feeInput.value = extraFee; 
    
    if (extraFee > 0 && feeTextEl) { 
        feeTextEl.style.display = 'block'; 
        feeTextEl.innerText = `${reasons.join(', ')} @ ₱${hourlyRate}/hr`; 
    } else if (feeTextEl) { 
        feeTextEl.style.display = 'none'; 
    }

    return { basePrice, extraFee };
}

function calculateBalance(bookingId) {
    const totalInput = document.getElementById(`totalPrice-${bookingId}`);
    const paidInput = document.getElementById(`amountPaid-${bookingId}`);
    const balanceDisplay = document.getElementById(`balanceDisplay-${bookingId}`);
    const iconContainer = document.getElementById(`paidIcon-${bookingId}`);

    const total = parseFloat(totalInput.value.replace(/,/g, '')) || 0;
    const paid = parseFloat(paidInput.value.replace(/,/g, '')) || 0;
    const balance = total - paid;

    balanceDisplay.innerText = balance.toLocaleString(undefined, { minimumFractionDigits: 2 });

    // Visual feedback for payment status
    if (balance <= 0 && total > 0) {
        iconContainer.innerHTML = '<i class="fas fa-check-circle text-success"></i>';
    } else if (paid > 0) {
        iconContainer.innerHTML = '<i class="fas fa-adjust text-warning"></i>';
    } else {
        iconContainer.innerHTML = '';
    }
}

// Helpers for currency formatting
function removeCommas(input) {
    input.value = input.value.replace(/,/g, '');
}

function formatCurrency(input) {
    const val = parseFloat(input.value);
    if (!isNaN(val)) {
        input.value = val.toLocaleString(undefined, { minimumFractionDigits: 2 });
    }
}

function updateGuestCount(bookingId) {
    const container = document.getElementById(`adminCompanions-${bookingId}`);
    const guestInput = document.getElementById(`guestCount-${bookingId}`);
    
    if (container && guestInput) {
        // Start with 1 (the Primary Guest)
        let total = 1; 
        
        // Select all companion cards
        const companionCards = container.querySelectorAll('.companion-card');
        
        companionCards.forEach(card => {
            const ageInput = card.querySelector('input[name="compAge[]"]');
            const age = parseInt(ageInput.value);
            
            // Logic: If age is empty, we assume they are a countable guest 
            // until proven to be an infant (age < 2).
            if (isNaN(age) || age >= 2) {
                total++;
            }
        });
        
        guestInput.value = total;

        // CRITICAL: Refresh fee calculations whenever guest count changes
        if (typeof runFullCalculation === 'function') {
            runFullCalculation(bookingId);
        }
    }
}

function validateAdminForm(id) {
    console.log("Validation started for ID:", id);

    const totalInput = document.getElementById(`totalPrice-${id}`);
    const paidInput = document.getElementById(`amountPaid-${id}`);
    const statusSelect = document.getElementById(`status-${id}`);
    const checkInInput = document.getElementById(`checkIn-${id}`);
    const checkOutInput = document.getElementById(`checkOut-${id}`);
    const extraFeeInput = document.getElementById(`extraFeeInput-${id}`);

    // --- 2. CRITICAL DATE FIX ---
    if (bookingState[id]) {
        const fpIn = bookingState[id].fpIn;
        const fpOut = bookingState[id].fpOut;

        // Use 'Y-m-d H:i' format to match what your backend usually expects from a string
        if (fpIn && fpIn.selectedDates.length > 0) {
            checkInInput.value = fpIn.formatDate(fpIn.selectedDates[0], "Y-m-d H:i");
        }
        if (fpOut && fpOut.selectedDates.length > 0) {
            checkOutInput.value = fpOut.formatDate(fpOut.selectedDates[0], "Y-m-d H:i");
        }
    }

    // --- 3. Clean Currency ---
    // Make sure we send numbers, not "₱1,000"
    const total = parseFloat(String(totalInput.value).replace(/[₱,]/g, '')) || 0;
    const paid = parseFloat(String(paidInput.value).replace(/[₱,]/g, '')) || 0;
    
    // Assign cleaned values back to inputs so they are submitted correctly
    totalInput.value = total;
    paidInput.value = paid;

    // --- 4. 50% Rule Validation ---
    const minRequired = total * 0.5;
    if (statusSelect.value !== 'cancelled' && paid < minRequired) { 
        alert(`Error: Downpayment must be at least 50% (₱${minRequired.toLocaleString()}).`);
        paidInput.focus();
        return false; 
    }

    // --- 5. Loading State ---
    const submitBtn = document.querySelector(`#modal-${id} button[type="submit"]`);
    if (submitBtn) {
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Saving...';
        submitBtn.disabled = true;
    }

    return true; 
}

